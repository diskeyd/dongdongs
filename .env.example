# Copy to your shell profile or a local .env that is never committed.
GEMINI_API_KEY=
# Optional: override the Gemini model used for read-assist calls.
DONGDONGS_GEMINI_MODEL=
# Optional: local test report PDF used by the test suite.
DONGDONGS_FIXTURE_PDF=
# Optional: path to the matching HWP report used by the test suite.
DONGDONGS_FIXTURE_HWP=
# Optional: local JSON with the values the real-file tests expect (default tests/local/expected.json).
DONGDONGS_FIXTURE_EXPECT=
