# dongdongs 설정 파일 (이 파일을 복사해 dongdongs.env 로 저장하고 값을 채우세요)
# 이미 시스템 환경변수로 설정된 값이 있으면 그 값이 우선합니다.

# Google AI Studio 에서 발급한 Gemini API 키 (선택). 있으면 아래첨자 항목명·워터마크 문자 판독에 씁니다.
GEMINI_API_KEY=

# 사용할 Gemini 모델 ID (선택). 비우면 프로그램 기본값을 씁니다.
DONGDONGS_GEMINI_MODEL=

# 개발자용: 실제 파일 테스트에 쓰는 성적서·보고서·기대값 경로 (선택)
DONGDONGS_FIXTURE_PDF=
DONGDONGS_FIXTURE_HWP=
DONGDONGS_FIXTURE_EXPECT=
